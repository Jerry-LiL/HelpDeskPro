NODE_ENV=development
PORT=3000
# Comma-separated if the console is served from more than one origin.
# localhost and 127.0.0.1 are accepted for whichever host you list.
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Leave SMTP_HOST empty to log mail instead of sending it.
# Point it at Mailhog (localhost:1025) or a real SMTP server to deliver mail.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HelpDeskPro <helpdesk@localhost>

# How often the SLA worker enqueues a breach scan.
SLA_SCAN_INTERVAL_MS=60000

# Create or update tables from entities on boot. Turn this off once you ship migrations.
SYNCHRONIZE=true
